    yr:weight          3 ;
    yr:position        0.78 ;
    yr:chartYear       2025.36 ;
    schema:recordedIn  [
        a                schema:VideoObject ;
        schema:url       <https://www.youtube.com/watch?v=cucQOOAahNY> ;
        schema:name      "Postgres Extensions Day 2025" ;
        schema:startDate "2025-05-12"^^xsd:date ;
        schema:location  "Montréal" ;
        yr:streamFrom    949 ;
        schema:hasPart   [ a schema:Clip ; schema:startOffset 949 ; yr:speaker "Yurii Rashkovskii" ; schema:name "Welcome" ],
                         [ a schema:Clip ; schema:startOffset 1065 ; yr:speaker "Hannu Krosing" ; schema:name "From pl/v8 to pl/<any>: towards easier extension development" ],
                         [ a schema:Clip ; schema:startOffset 2847 ; yr:speaker "Andrey Borodin" ; schema:name "Upgrade as an extension" ],
                         [ a schema:Clip ; schema:startOffset 4693 ; yr:speaker "Paul Jungwirth" ; schema:name "Inlining Postgres Functions, Now and Then" ],
                         [ a schema:Clip ; schema:startOffset 6520 ; yr:speaker "Alvaro Hernandez" ; schema:name "Postgres à la carte: dynamic container images with your choice of extensions" ],
                         [ a schema:Clip ; schema:startOffset 8752 ; yr:speaker "Yurii Rashkovskii" ; schema:name "Extension Upgrades" ; yr:talk :talk-ext-upgrades ],
                         [ a schema:Clip ; schema:startOffset 10165 ; yr:speaker "Phil Eaton" ; schema:name "Working with MemoryContexts and debugging memory leaks in Postgres" ],
                         [ a schema:Clip ; schema:startOffset 11707 ; yr:speaker "Sweta Vooda" ; schema:name "Postgres as a Control Plane: Challenges in Offloading Compute via Extensions" ],
                         [ a schema:Clip ; schema:startOffset 17423 ; yr:speaker "Ruohang Feng" ; schema:name "The Missing Postgres Extension Repo and Package Manager" ],
                         [ a schema:Clip ; schema:startOffset 18944 ; yr:speaker "David Wheeler" ; schema:name "How to automatically release your extensions on PGXN" ],
                         [ a schema:Clip ; schema:startOffset 20936 ; yr:speaker "Cary Huang" ; schema:name "Extending PostgreSQL with Java: Overcoming Development Challenges in Bridging Java and C Application" ],
                         [ a schema:Clip ; schema:startOffset 22733 ; yr:speaker "Cheng Chen" ; schema:name "Rethinking OLAP Architecture: The Journey to pg_mooncake v0.2" ],
                         [ a schema:Clip ; schema:startOffset 24373 ; yr:speaker "Florents Tselai" ; schema:name "Spat: Hijacking Shared Memory for a Redis-Like Experience in PostgreSQL" ],
                         [ a schema:Clip ; schema:startOffset 26283 ; yr:speaker "Yurii Rashkovskii" ; schema:name "Cppgres: One less reason to hate C++" ; yr:talk :talk-cppgres ],
                         [ a schema:Clip ; schema:startOffset 28187 ; yr:speaker "Alastair Turner" ; schema:name "Extensibility - new options and a wish list" ]
    ] .

:yrashk yr:built :strata .
:strata
    a                  yr:Project, schema:CreativeWork ;
    schema:name        "Strata" ;
    schema:url         <https://yrashk.com/strata> ;
    schema:description "A 64-bit machine where memory is explicit I/O." ;
    schema:abstract    "A prototype instruction set and the small operating system that proves it. Local Stores instead of caches; transfers that complete with a tag; no interrupts." ;
    yr:quote           "The machine shows through instead of being hidden." ;
    yr:voice           "The machine shows through instead of being hidden." ;
    yr:role            "author" ;
    yr:status          "active · pushed today" ;
    yr:group           "stunts" ;
    yr:sector          <sector/machines> ;
    ord:inOrdering     <ordering/chart> ;
    ord:rank           170 ;
    yr:start           "2026"^^xsd:gYear ;
    yr:weight          4 ;
    yr:position        0.5 ;
    yr:color           "#e9e4d9" ;
    yr:repos           ( <repo/yrashk/strata> ) ;
    yr:notes           (
        "RTL, a C emulator with JITs, the StrataOS microkernel written in Strata assembly, Strata Forth, and a browser playground."
        "Local Stores, not caches: 64 KiB per core. Transfers carry completion tags: tget, tput, tany. Linear capabilities."
        "StrataOS has a tiled window server and a strip of core cells that pulse on context switches — this desktop is its cousin."
    ) .

