# The Atlas of yrashk.com: the hand-curated half, edited by hand. Vocabulary: site/DATA.md.
# GitHub data is generated into github.ttl (scripts/github-rdf.mjs); the build queries both with the
# WAT engine (scripts/atlas.mjs) and writes /data/atlas.js for the desktop. Run `npm run build` to check it.

@base   <https://yrashk.com/atlas/> .
@prefix :       <https://yrashk.com/atlas/> .
@prefix yr:     <https://yrashk.com/ns#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ord:    <https://ontology.inferal.com/modules/ordering/> .

# ── Yurii Rashkovskii ──
# yr:homes in clock order; yr:defaultLocation is where he is when no stay covers the day.
# yr:stay: where he is or will be. Dates are days in the place's own calendar, endDate inclusive and
# optional (open-ended). The current stay is the latest one that has started; its endDate ends it only when
# the next stay does not begin the day after.

:yrashk
    a                  schema:Person ;
    schema:name        "Yurii Rashkovskii" ;
    schema:url         <https://yrashk.com> ;
    schema:birthDate   "1981"^^xsd:gYear ;
    schema:birthPlace  :ukraine ;
    yr:homes           ( :redwood-city :comox ) ;
    yr:defaultLocation :comox ;
    yr:stay            [ a yr:Stay ; yr:place :bangkok ; schema:startDate "2026-11-22"^^xsd:date ; schema:endDate "2026-12-07"^^xsd:date ],
                       [ a yr:Stay ; yr:place :redwood-city ; schema:startDate "2026-12-08"^^xsd:date ; schema:endDate "2026-12-25"^^xsd:date ],
                       [ a yr:Stay ; yr:place :bangkok ; schema:startDate "2026-12-26"^^xsd:date ; schema:endDate "2027-01-14"^^xsd:date ],
                       [ a yr:Stay ; yr:place :china ; schema:startDate "2027-01-15"^^xsd:date ; schema:endDate "2027-01-22"^^xsd:date ],
                       [ a yr:Stay ; yr:place :redwood-city ; schema:startDate "2027-01-23"^^xsd:date ] .

# ── Places (yr:timeZone: an IANA zone; a place needs one to be a home or a stay) ──

:redwood-city
    a           schema:Place ;
    schema:name "Redwood City, CA" ;
    schema:geo  [ schema:latitude 37.49 ; schema:longitude -122.24 ] ;
    yr:timeZone "America/Los_Angeles" .

:comox
    a           schema:Place ;
    schema:name "Comox, BC" ;
    schema:geo  [ schema:latitude 49.67 ; schema:longitude -124.93 ] ;
    yr:timeZone "America/Vancouver" .

:san-francisco
    a           schema:Place ;
    schema:name "San Francisco, CA" ;
    schema:geo  [ schema:latitude 37.77 ; schema:longitude -122.42 ] ;
    yr:timeZone "America/Los_Angeles" .

:canada
    a           schema:Place ;
    schema:name "Canada" ;
    schema:geo  [ schema:latitude 56.13 ; schema:longitude -106.35 ] ;
    yr:timeZone "America/Vancouver" .

:ukraine
    a           schema:Place ;
    schema:name "Ukraine" ;
    schema:geo  [ schema:latitude 49.0 ; schema:longitude 32.0 ] ;
    yr:timeZone "Europe/Kyiv" .

:bangkok
    a           schema:Place ;
    schema:name "Bangkok, Thailand" ;
    schema:geo  [ schema:latitude 13.76 ; schema:longitude 100.5 ] ;
    yr:timeZone "Asia/Bangkok" .

:china
    a           schema:Place ;
    schema:name "China" ;
    schema:geo  [ schema:latitude 35.86 ; schema:longitude 104.2 ] ;
    yr:timeZone "Asia/Shanghai" .

# ── Orderings (the Ontosome ordering module: https://ontosome.com/modules/ordering/) ──
# A lesser ord:rank comes first. Ranks step by 10 so a new body can go between two without renumbering.
# <ordering/chart>: the order the desktop receives bodies in. Among bodies of the same weight, the earlier
# one keeps its label where labels collide. Partial: a body without a rank comes after every ranked one
# (by kind, start year, id).

<ordering/chart>
    a                 ord:PartialOrdering ;
    rdfs:label        "Atlas chart order" ;
    ord:rankDirection ord:AscendingRank .

<ordering/sectors>
    a                 ord:TotalOrdering ;
    rdfs:label        "Sector drawing order" ;
    ord:rankDirection ord:AscendingRank .

# ── Sectors: the slices of the chart, drawn in <ordering/sectors> ──

<sector/companies> a yr:Sector ; rdfs:label "Companies" ; ord:inOrdering <ordering/sectors> ; ord:rank 1 .
<sector/data> a yr:Sector ; rdfs:label "Data" ; ord:inOrdering <ordering/sectors> ; ord:rank 2 .
<sector/machines> a yr:Sector ; rdfs:label "Machines & languages" ; ord:inOrdering <ordering/sectors> ; ord:rank 3 .
<sector/writing> a yr:Sector ; rdfs:label "Words & ideas" ; ord:inOrdering <ordering/sectors> ; ord:rank 4 .
<sector/life> a yr:Sector ; rdfs:label "Life" ; ord:inOrdering <ordering/sectors> ; ord:rank 5 .

