:yrashk yr:built :lasocket .
:lasocket
    a                  yr:Project, schema:CreativeWork ;
    schema:name        "lasocket" ;
    schema:url         <https://github.com/yrashk/lasocket> ;
    schema:description "One IP, many machines answering it at once." ;
    schema:abstract    "Active-active TCP and UDP sockets across a LAN. Every node holds every connection; kill nodes, kill the coordinator, replace every machine, and nc, curl and ping sessions keep going, byte-exact." ;
    yr:role            "author" ;
    yr:status          "active" ;
    yr:group           "stunts" ;
    yr:sector          <sector/machines> ;
    ord:inOrdering     <ordering/chart> ;
    ord:rank           210 ;
    yr:start           "2026"^^xsd:gYear ;
    yr:weight          3 ;
    yr:position        0.64 ;
    yr:color           "#7fd6b0" ;
    yr:repos           ( <repo/yrashk/lasocket> ) ;
    yr:notes           (
        "No coordinator on the hot path: who sends each segment block is a rendezvous hash over the live members, and nothing is acknowledged until two nodes hold it."
        "Adapts to the switch: multicast, flood or relay per neighbor. No router or switch configuration."
        "Rust. A Docker demo kills nodes, flips the switch through four scenarios and runs a chaos monkey while clients verify every byte."
    ) .

